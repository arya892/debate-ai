# DEBATE AI – Environment Configuration

# Database: SQLite by default; use postgresql://user:pass@localhost:5432/debate_ai for PostgreSQL
DATABASE_URL=sqlite:///./debate_ai.db

# LLM Providers (Configure at least one for live LLM, or leave empty for intelligent heuristic engine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Web Search Providers (Optional: Tavily or Brave Search; DuckDuckGo fallback runs if unset)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Server Config
HOST=0.0.0.0
PORT=8000

